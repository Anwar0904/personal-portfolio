# Generate a long random value, e.g. with: openssl rand -base64 32
SESSION_SECRET=

# PostgreSQL connection string, e.g. postgresql://user:password@host:5432/portfolio?sslmode=require
DATABASE_URL=

# Google Cloud OAuth 2.0 web client credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Add this exact URL to the OAuth client's authorized redirect URIs.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback

# Optional: this verified Google account receives the admin role on first login.
OWNER_EMAIL=
